# Secret used to sign authentication JWTs. Use a long random value.
JWT_SECRET=replace_with_a_long_random_secret

# Required for USDA FoodData Central searches.
USDA_API_KEY=your_api_key_here

# Optional: override the SQLite database location.
# DATABASE_PATH=./.data/cyclefuel.sqlite

# Comma-separated emails of existing accounts granted administrator access on startup.
# ADMIN_EMAILS=admin@example.com

